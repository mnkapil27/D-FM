# Copy this file to ".env" and fill the values. NEVER commit the .env file.

# System User access token from Meta Business Settings (starts with "EAA...")
META_ACCESS_TOKEN=

# Graph API version. Change only if Meta says this version is too old.
META_API_VERSION=v23.0

# Long random secret that protects your server on the internet.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# Optional: max budget for ALL clients (account currency). Client limits in clients.json win.
GLOBAL_MAX_DAILY_BUDGET=
GLOBAL_MAX_LIFETIME_BUDGET=

# Client list: either a file...
CLIENTS_FILE=clients.json
# ...or the whole JSON in one line (easier on Render / Railway). If set, the file is ignored.
# CLIENTS_JSON={"clients":{"pizza_hub":{"name":"Pizza Hub","ad_account_id":"act_123","page_id":"456"}}}

# Allow tools to use an ad account id (act_123...) that is not in clients.json. Default false.
ALLOW_UNKNOWN_ACCOUNTS=false
